{
  "name": "homelab-dev",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  // HOME on Linux and macOS, USERPROFILE on Windows: exactly one expands
  "mounts": [
    "source=${localEnv:HOME}${localEnv:USERPROFILE}/.kube,target=/root/.kube,type=bind",
    "source=${localEnv:HOME}${localEnv:USERPROFILE}/.talos,target=/root/.talos,type=bind",
    "source=homelab-claude-config,target=/root/.claude,type=volume"
  ],
  "remoteEnv": {
    "GRAFANA_MCP_TOKEN": "${localEnv:GRAFANA_MCP_TOKEN}"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "anthropic.claude-code",
        "github.vscode-github-actions",
        "hashicorp.terraform",
        "ms-kubernetes-tools.vscode-kubernetes-tools",
        "redhat.vscode-yaml",
        "tamasfe.even-better-toml",
        "timonwong.shellcheck"
      ]
    }
  }
}
