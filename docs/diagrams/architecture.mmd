flowchart TB
    browser([Browser])
    dns(["Cloudflare DNS<br/>one A record per app"])
    github(["GitHub<br/>davydehaas98/homelab"])

    unifi["UniFi Gateway Ultra<br/>port forward :80, :443"]

    subgraph k8s["Cluster yggdrasil, Talos"]
        subgraph rk1["4x Turing RK1, arm64"]
            envoy["Envoy Gateway<br/>192.168.1.56"]
            argo["Argo CD"]
        end
        subgraph midgard["midgard-0, amd64: apps with data"]
            authentik["Authentik<br/>OIDC login"]
            apps["Media apps<br/>Plex, Sonarr, Radarr, Lidarr, Prowlarr,<br/>Bazarr, SABnzbd, Seerr, Jellyfin"]
            immich["Immich<br/>CloudNativePG database"]
            factorio["Factorio<br/>LoadBalancer 192.168.1.58"]
            monitoring["Prometheus, Grafana, Loki"]
            fast[("ZFS fast, NVMe<br/>configs + databases")]
            tank[("ZFS tank, RAIDZ1<br/>files + backups")]
            media[("Media disk<br/>media + downloads")]
        end
    end

    browser -->|resolves| dns
    dns -.->|A record| unifi
    browser -->|HTTPS| unifi
    unifi -->|forward| envoy
    envoy -->|OIDC| authentik
    envoy -->|HTTPRoute| apps
    envoy -->|HTTPRoute| immich
    browser -.->|UDP 34197| factorio

    apps -->|local volume| media
    apps -->|zfs-fast| fast
    apps -->|app backups| tank
    immich -->|photo library| tank
    immich -->|database| fast
    fast -->|nightly copy| tank

    github -->|syncs main| argo
    argo -->|deploys| apps
    argo -->|deploys| monitoring
    monitoring -.->|scrapes| apps

    classDef server fill:#e8eef7,stroke:#5b7bb0,color:#000
    classDef cluster fill:#eaf5ea,stroke:#4f9a4f,color:#000
    class midgard server
    class k8s,rk1 cluster
