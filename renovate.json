{
  "extends": [
    "github>davydehaas98/renovate-config"
  ],
  "baseBranchPatterns": [
    "main"
  ],
  "separateMinorPatch": true,
  "automergeSchedule": [
    "* * * * *"
  ],
  "packageRules": [
    {
      "matchUpdateTypes": [
        "patch",
        "digest"
      ],
      "automerge": true,
      "ignoreTests": true
    },
    {
      "description": "linuxserver still publishes tags of Lidarr 0.8 (2021) as 8.x, which look newer than the current 3.x.",
      "matchPackageNames": [
        "ghcr.io/linuxserver/lidarr"
      ],
      "allowedVersions": "<8"
    }
  ],
  "argocd": {
    "managerFilePatterns": [
      "/\\.yaml$/"
    ]
  }
}
