{
  "extends": [
    "github>davydehaas98/renovate-config"
  ],
  "baseBranchPatterns": [
    "main"
  ],
  "separateMinorPatch": true,
  "commitMessagePrefix": "[{{#if parentDir}}{{parentDir}}{{else}}{{manager}}{{/if}}]",
  "additionalBranchPrefix": "{{#if parentDir}}{{parentDir}}{{else}}{{manager}}{{/if}}-",
  "automergeSchedule": [
    "* 0-6 * * *"
  ],
  "packageRules": [
    {
      "matchUpdateTypes": [
        "patch",
        "digest"
      ],
      "automerge": true,
      "ignoreTests": true
    }
  ],
  "argocd": {
    "managerFilePatterns": [
      "/\\.yaml$/"
    ]
  }
}
